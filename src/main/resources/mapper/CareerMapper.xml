<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.portfolio.mapper.CareerMapper">

    <resultMap id="CareerResultMap" type="com.example.portfolio.entity.Career">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="year" column="year"/>
        <result property="name" column="name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAllByUserId" resultMap="CareerResultMap">
        SELECT * FROM careers
        WHERE user_id = #{userId}
        ORDER BY year
    </select>

    <insert id="insert" parameterType="com.example.portfolio.entity.Career" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO careers(user_id, year, name, created_at, updated_at)
        VALUES(#{userId}, #{year}, #{name}, now(), now())
    </insert>

    <delete id="deleteAllByUserId">
        DELETE FROM careers
        WHERE user_id = #{userId}
    </delete>

</mapper>
