<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.portfolio.mapper.EventMapper">

    <resultMap id="EventResultMap" type="com.example.portfolio.entity.Event">
        <id property="id" column="id"/>
        <result property="year" column="year"/>
        <result property="name" column="name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="EventResultMap">
        SELECT * FROM events ORDER BY year ASC, id ASC
    </select>

    <delete id="deleteAll">
        DELETE FROM events
    </delete>

    <insert id="insert" parameterType="com.example.portfolio.entity.Event" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO events(year, name, created_at, updated_at)
        VALUES(#{year}, #{name}, now(), now())
    </insert>

</mapper>
