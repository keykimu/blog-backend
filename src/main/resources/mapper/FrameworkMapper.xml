<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.portfolio.mapper.FrameworkMapper">
    <resultMap id="FrameworkResultMap" type="com.example.portfolio.entity.Framework">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="level" column="level"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="FrameworkResultMap">
        SELECT * FROM framework ORDER BY id ASC
    </select>

    <insert id="insert" parameterType="com.example.portfolio.entity.Framework" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO framework(name, level, created_at, updated_at)
        VALUES (#{name}, #{level}, now(), now())
    </insert>

    <delete id="deleteAll">
        DELETE FROM framework
    </delete>
</mapper>
