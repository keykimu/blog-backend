<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.portfolio.mapper.LanguageMapper">

    <resultMap id="LanguageResultMap" type="com.example.portfolio.entity.Language">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="level" column="level"/>
        <result property="experience" column="experience"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAllByUserId" resultMap="LanguageResultMap">
        SELECT * FROM languages
        WHERE user_id = #{userId}
        ORDER BY id ASC
    </select>

    <delete id="deleteAllByUserId">
        DELETE FROM languages
        WHERE user_id = #{userId}
    </delete>

    <insert id="insert" parameterType="com.example.portfolio.entity.Language"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO languages(user_id, name, level, experience, created_at, updated_at)
        VALUES(#{userId}, #{name}, #{level}, #{experience}, now(), now())
    </insert>

</mapper>
