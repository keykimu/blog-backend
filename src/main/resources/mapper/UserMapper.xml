<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.portfolio.mapper.UserMapper">
    <resultMap id="UserResultMap" type="com.example.portfolio.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="lastLoginAt" column="last_login_at"/>
    </resultMap>

    <select id="findAll" resultMap="UserResultMap">
        SELECT id, username, created_at, updated_at, last_login_at
        FROM "user"
        ORDER BY id
    </select>

    <select id="findByUsername" resultType="com.example.portfolio.entity.User">
        SELECT id, username, password, created_at, updated_at, last_login_at
        FROM "user"
        WHERE username = #{username}
    </select>

    <update id="updateLastLogin">
        UPDATE "user"
        SET last_login_at = #{time}
        WHERE id = #{id}
    </update>
</mapper>
